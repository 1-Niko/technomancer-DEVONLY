<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<LangVersion>preview</LangVersion>
		<AssemblyName>Slugpack</AssemblyName>
		<Nullable>disable</Nullable>
		<RootNamespace>Slugpack</RootNamespace>
		<PathMap>$(MSBuildProjectDirectory)=/$(SolutionName)</PathMap>
	</PropertyGroup>

	<Target Name="GenerateMod" AfterTargets="PostBuildEvent">
		<ItemGroup>
			<RemovePlugins Include="../mod/newest/plugins/*.dll" />
			<RemovePDBs Include="$(OutDir)*.pdb" />
		</ItemGroup>
		<ItemGroup>
			<CopyPlugins Include="$(TargetPath)" />
			<CopyPDBs Include="$(OutDir)*.pdb" />
		</ItemGroup>
		<Delete Files="@(RemovePlugins)" />
		<Copy SourceFiles="@(CopyPlugins);@(CopyPDBs)" DestinationFolder="../mod/newest/plugins/" />
	</Target>


	<ItemGroup>
		<Reference Include="../lib/*.dll">
			<Private>false</Private>
		</Reference>
	</ItemGroup>


	<ItemGroup>
	  <Compile Remove="Dependencies\**" />
	  <EmbeddedResource Remove="Dependencies\**" />
	  <None Remove="Dependencies\**" />
	  <Reference Remove="Dependencies\**" />
	</ItemGroup>


	<ItemGroup>
	  <Reference Include="BepInEx">
	    <HintPath>Dependencies\BepInEx.dll</HintPath>
	  </Reference>
	  <Reference Include="HOOKS-Assembly-CSharp">
	    <HintPath>Dependencies\HOOKS-Assembly-CSharp.dll</HintPath>
	  </Reference>
	  <Reference Include="Assembly-CSharp">
	    <HintPath>Dependencies\PUBLIC-Assembly-CSharp.dll</HintPath>
	  </Reference>
	  <Reference Include="Unity.Mathematics">
	    <HintPath>Dependencies\Unity.Mathematics.dll</HintPath>
	  </Reference>
	  <Reference Include="UnityEngine">
	    <HintPath>Dependencies\UnityEngine.dll</HintPath>
	  </Reference>
	  <Reference Include="UnityEngine.AudioModule">
	    <HintPath>Dependencies\UnityEngine.AudioModule.dll</HintPath>
	  </Reference>
	  <Reference Include="UnityEngine.CoreModule">
	    <HintPath>Dependencies\UnityEngine.CoreModule.dll</HintPath>
	  </Reference>
	  <Reference Include="UnityEngine.InputLegacyModule">
	    <HintPath>Dependencies\UnityEngine.InputLegacyModule.dll</HintPath>
	  </Reference>
	</ItemGroup>


	<ItemGroup>
		<Folder Include="Campaigns\Common Utils\" />
	</ItemGroup>


</Project>
